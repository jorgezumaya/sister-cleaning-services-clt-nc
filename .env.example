# Contact form email delivery (Resend — https://resend.com)
# Personal email is never referenced in client code; only these server-only
# vars, set in Cloudflare Pages project settings (or .env.local for dev).
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@sisterscleaningservicenc.com
CONTACT_FROM_EMAIL=quotes@sisterscleaningservicenc.com

# Firebase Storage — public read-only bucket that powers the photo gallery.
# These are safe to expose to the browser (Storage security rules gate
# access, not these values). Upload photos to the `gallery/` folder in the
# Firebase console and they show up on the site automatically.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
